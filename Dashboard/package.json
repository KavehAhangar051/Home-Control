{
  "name": "home-control-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:webpack": "next dev --webpack -p 3000 -H 0.0.0.0",
    "build": "NODE_ENV=production next build --turbopack",
    "start": "next start",
    "analyze": "next analyze --output",
    "lint": "biome lint --max-diagnostics=1000 app components features lib",
    "format": "biome format --write app components features lib",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/ts-loader.mjs --test tests/*.test.mjs",
    "check": "bun run lint && bun run typecheck && bun run test",
    "clean": "node -e \"['.next', 'out', 'tsconfig.tsbuildinfo'].forEach(p => require('fs').rmSync(p, { recursive: true, force: true }))\"",
    "lint:ox": "oxlint app components features lib",
    "analyze:export": "next analyze export",
    "cbm": "bash ./tools/cbm.sh cli",
    "cbm:index": "bash ./tools/cbm.sh index",
    "rtk": "bash ./tools/rtk.sh",
    "rtk:gain": "bash ./tools/rtk.sh gain",
    "rtk:setup": "bash ./tools/rtk.sh setup",
    "te": "bash ./tools/te.sh",
    "te:status": "bash ./tools/te.sh status",
    "te:doctor": "bash ./tools/te.sh doctor",
    "te:setup": "bash ./tools/te.sh setup",
    "r": "bash ./tools/r",
    "agent:start": "python3 ./tools/agent-bridge.py start",
    "agent:end": "python3 ./tools/agent-bridge.py end",
    "tools:check": "python3 ./tools/agent-bridge.py check",
    "android:prepare": "bun install @capacitor/core@8.6.2 @capacitor/cli@8.6.2 @capacitor/android@8.6.2 --no-save && (test -d android || cap add android)",
    "android:sync": "cap sync android",
    "android:apk": "bun run build && bun run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.3",
    "@base-ui/react": "^1.4.1",
    "@danfessler/trellis": "^0.3.0",
    "@danfessler/trellis-react": "^0.3.0",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "lucide-react": "^1.74.0",
    "motion": "^14.0.0",
    "mqtt": "^5.15.1",
    "next": "^16.4.6",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@oxlint/plugins": "1.94.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.5",
    "@typescript/typescript6": "6.0.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
