{
  "name": "achaemenid-iot-node-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "r": "bash ./tools/r",
    "pio": "bash ./tools/pio.sh",
    "pio:setup": "bash ./tools/pio.sh setup",
    "pio:ensure": "bash ./tools/pio.sh ensure",
    "pio:test": "bash ./tools/pio.sh test -e native",
    "pio:build": "bash ./tools/pio.sh run -e esp32dev",
    "cpp:setup": "bash ./tools/cpp.sh setup",
    "cpp:ensure": "bash ./tools/cpp.sh ensure",
    "cpp:compiledb": "bash ./tools/cpp.sh compiledb",
    "cpp:format": "bash ./tools/cpp.sh format",
    "cpp:format:check": "bash ./tools/cpp.sh format:check",
    "cpp:lint": "bash ./tools/cpp.sh lint",
    "cpp:tidy": "bash ./tools/cpp.sh tidy",
    "cpp:typecheck": "bash ./tools/cpp.sh typecheck",
    "rtk": "bash ./tools/rtk.sh",
    "rtk:gain": "bash ./tools/rtk.sh gain",
    "rtk:setup": "bash ./tools/rtk.sh setup",
    "rtk:ensure": "bash ./tools/rtk.sh ensure",
    "postinstall": "bash ./tools/rtk.sh setup || true; bash ./tools/pio.sh ensure || true; bash ./tools/cpp.sh ensure || true"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "@vitejs/plugin-react": "^5.0.4"
  }
}
