#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RTK_BIN="$ROOT_DIR/.agent-state/rtk/bin/rtk"

# Keep the independent RTK optimizer available without the removed agent bridge.
bash "$ROOT_DIR/tools/rtk.sh" ensure
bash "$ROOT_DIR/tools/pio.sh" ensure
bash "$ROOT_DIR/tools/cpp.sh" ensure

if [ "$#" -eq 0 ]; then
  exec bash "$ROOT_DIR/tools/rtk.sh" gain
fi

if [ "$1" = "--raw" ]; then
  shift
  exec "$@"
fi

if [ "$1" = "rtk" ] || [ "$1" = "$RTK_BIN" ]; then
  shift
  exec "$RTK_BIN" "$@"
fi

case "$1" in
  ls|tree|read|smart|git|gh|glab|aws|psql|pnpm|err|test|json|deps|env|find|diff|log|dotnet|docker|kubectl|oc|summary|grep|rg|ast-grep|wget|wc|jest|vitest|ctest|prisma|tsc|ng|next|lint|prettier|format|cargo|npm|npx|curl)
    exec "$RTK_BIN" "$@"
    ;;
  bun)
    if [ "${2:-}" = "run" ] && [ -n "${3:-}" ]; then
      case "$3" in
        r|pio|pio:*|cpp:*|rtk|rtk:*)
          exec "$@"
          ;;
        *)
          exec "$RTK_BIN" npm run "$3" "${@:4}"
          ;;
      esac
    fi
    exec "$@"
    ;;
  *)
    exec "$@"
    ;;
esac
