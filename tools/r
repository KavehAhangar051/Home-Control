#!/usr/bin/env bash
set -euo pipefail

# Unified shell wrapper: auto-restores rtk, cbm, pio, and TokenEconomizer if container reset,
# compresses output via rtk (Lite Mode), and records tool telemetry + LoopGuard + micro-skills.
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 "$ROOT_DIR/tools/agent-bridge.py" run "$@"
