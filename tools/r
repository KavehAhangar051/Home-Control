#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RTK_BIN="$ROOT_DIR/.agent-state/rtk/bin/rtk"

ensure_rtk() {
  bash "$ROOT_DIR/tools/rtk.sh" ensure
}

if [ "$#" -eq 0 ]; then
  exec bash "$ROOT_DIR/tools/rtk.sh" gain
fi

# Explicit raw execution bypasses RTK and all tool bootstrapping.
if [ "$1" = "--raw" ]; then
  shift
  if [ "$#" -eq 0 ]; then
    echo "Usage: tools/r --raw <command> [args...]" >&2
    exit 2
  fi
  exec "$@"
fi

# Keep the dedicated tool wrappers responsible for their own lazy setup.
case "$1" in
  rtk)
    shift
    exec bash "$ROOT_DIR/tools/rtk.sh" "$@"
    ;;
  pio|platformio)
    shift
    exec bash "$ROOT_DIR/tools/pio.sh" "$@"
    ;;
  bun|npm)
    if [ "${2:-}" = "run" ] && [ -n "${3:-}" ]; then
      runner="$1"
      script="$3"
      shift 3
      [ "${1:-}" = "--" ] && shift
      case "$script" in
        r)
          exec bash "$ROOT_DIR/tools/r" "$@"
          ;;
        pio|pio:*|cpp:*|rtk|rtk:*)
          exec "$runner" run "$script" "$@"
          ;;
      esac
      ensure_rtk
      exec "$RTK_BIN" npm run "$script" "$@"
    fi
    ;;
esac

case "$1" in
  ls|tree|read|smart|git|gh|glab|aws|psql|pnpm|err|test|json|deps|env|find|diff|log|dotnet|docker|kubectl|oc|summary|grep|rg|ast-grep|wget|wc|jest|vitest|ctest|prisma|tsc|ng|next|lint|prettier|format|cargo|npm|npx|curl)
    ensure_rtk
    exec "$RTK_BIN" "$@"
    ;;
  *)
    exec "$@"
    ;;
esac
