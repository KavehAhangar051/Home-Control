# Optional public endpoint for the browser-side Cloudflare Worker integration.
# This value is exposed to the client bundle; never put secrets in NEXT_PUBLIC_* variables.
# If omitted, the app uses its built-in default and the Worker URL can be configured in Settings.
NEXT_PUBLIC_CLOUDFLARE_WORKER_URL="https://your-worker.example.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
